# Build context only. Everything here is either rebuilt inside the image or never read by
# it; without this the context is hundreds of megabytes of virtualenv and git history.
.venv/
.git/
.github/
logs/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets stay out of the image. Every setting is read from os.getenv, so Azure Container
# Apps supplies them as environment variables - baking a .env into a layer puts live
# credentials in the registry, where anyone who can pull the image can read them.
.env
.env.*

# Not part of either deployed service. app.py is NOT here: it is the UI image's entrypoint,
# and one context feeds both builds.
scripts/
tests/
pytest.ini
*.md
~$*
